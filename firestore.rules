rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'type', 'amount', 'category', 'title', 'date', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'type', 'amount', 'category', 'title', 'date', 'paymentMethod', 'note', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && (data.type == 'income' || data.type == 'expense')
        && data.amount is number && data.amount > 0 && data.amount <= 1000000000
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50))
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && data.createdAt is string && data.createdAt.size() <= 60
        && data.updatedAt is string && data.updatedAt.size() <= 60;
    }

    function isValidBudget(data) {
      return data.keys().hasAll(['userId', 'month', 'category', 'amount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'month', 'category', 'amount', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.month is string && data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && data.amount is number && data.amount >= 0 && data.amount <= 1000000000
        && data.createdAt is string && data.createdAt.size() <= 60
        && data.updatedAt is string && data.updatedAt.size() <= 60;
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(transactionId)
        && isValidTransaction(incoming());
      allow update: if isSignedIn()
        && isValidId(transactionId)
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && incoming().createdAt == existing().createdAt
        && isValidTransaction(incoming());
      allow delete: if isSignedIn()
        && isValidId(transactionId)
        && existing().userId == request.auth.uid;
    }

    // Budgets collection
    match /budgets/{budgetId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(budgetId)
        && isValidBudget(incoming());
      allow update: if isSignedIn()
        && isValidId(budgetId)
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && incoming().createdAt == existing().createdAt
        && isValidBudget(incoming());
      allow delete: if isSignedIn()
        && isValidId(budgetId)
        && existing().userId == request.auth.uid;
    }
  }
}
